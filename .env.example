# OpenAI-compatible model endpoint.
# Official OpenAI example:
# QADEV_LLM_BASE_URL=https://api.openai.com/v1
# QADEV_LLM_API_KEY=sk-...
# QADEV_LLM_MODEL=your-model-name

# OpenRouter example:
# QADEV_LLM_BASE_URL=https://openrouter.ai/api/v1
# QADEV_LLM_API_KEY=sk-or-v1-...
# QADEV_LLM_MODEL=your-openrouter-model

# Optional metadata headers accepted by some relay providers such as OpenRouter.
# QADEV_LLM_HTTP_REFERER=https://example.local
# QADEV_LLM_APP_TITLE=QA-to-Dev Prompt Agent
